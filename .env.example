# Copy this file to .env for local development.
# Never commit .env or real credentials.

# Paths
DEMO_DATA_DIR=demo_data
STORAGE_DIR=storage

# Database: SQLite works with zero setup.
DATABASE_URL=sqlite:///storage/tenderbridge.db
CHECKPOINT_URL=
RULE_PACK_PATH=
# Postgres 16 + pgvector (`make db-up`, then `make migrate && make seed`):
# DATABASE_URL=postgresql+psycopg://tenderbridge:tenderbridge@localhost:5433/tenderbridge
# CHECKPOINT_URL=postgresql://tenderbridge:tenderbridge@localhost:5433/tenderbridge
# Optional: run the tests on Postgres (`make test-pg` sets this for you)
# TEST_DATABASE_URL=postgresql+psycopg://tenderbridge:tenderbridge@localhost:5433/tenderbridge_test

# LLM providers (provider:model). fake:* runs offline with deterministic heuristics.
LLM_FAST=fake:fast
LLM_STRONG=fake:strong
LLM_TIMEOUT_S=60
# Real routing (see llm_routing_and_budget.json; verify model IDs first):
# LLM_FAST=groq:openai/gpt-oss-20b
# LLM_STRONG=groq:openai/gpt-oss-120b
# Drafting model is set per node: google_genai:gemini-3-flash
# Keys are read from this file and exported to the process environment for the SDKs.
# A node planned for a provider without a key falls back to LLM_FAST / LLM_STRONG.
GROQ_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY= also works (copied to GOOGLE_API_KEY)

# Embeddings
# hash = offline, no download. huggingface:BAAI/bge-m3 = local model (1024-d); after changing it run
# `uv run python dev.py reembed` (vectors from another embedder are ignored by search until then).
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=1024
# HF_TOKEN=   (optional: faster/authenticated Hugging Face downloads)
RERANKER=none

# Optional tracing: nothing is sent unless LANGSMITH_TRACING=true and a key is set. Inputs and
# outputs are redacted (emails, phones, PAN/Aadhaar, API keys; restricted KB text withheld).
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=tenderbridge
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=

# Analysis and budget limits
MAX_COST_USD=5
MAX_LLM_CALLS=400
MAX_RETRIES=1
MAX_REWRITES=2
MAX_PARALLEL_LLM=4

# Application behaviour
DEMO_MODE=true
ANALYSIS_MODE=focused
DEFAULT_COMPANY_ID=NIMBUS-001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=false

# Upload limits
MAX_UPLOAD_MB=50
MAX_ZIP_ENTRIES=200
MAX_ZIP_UNCOMPRESSED_MB=300

# Optional document parsing
TB_USE_DOCLING=0
